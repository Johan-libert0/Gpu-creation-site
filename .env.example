# Public Auth0 identifiers supplied for this application.
AUTH0_DOMAIN=dev-a47ow65vustjo8g7.us.auth0.com
AUTH0_CLIENT_ID=y1GzPxPSdedUbnltWfAWVYuJ1Fn89p0Y
AUTH0_CLIENT_SECRET=replace-in-deployment-secret-manager
AUTH0_SECRET=replace-with-a-random-session-secret-of-at-least-32-bytes
AUTH0_ALLOWED_EMAILS=you@example.com
BASE_URL=https://your-render-service.onrender.com

# Persistent PostgreSQL storage and source-payload encryption.
NODE_ENV=production
HOST=0.0.0.0
PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATA_ENCRYPTION_KEY=generate-a-32-byte-key-as-64-hex-characters
PRIVACY_MODE=external-provider

# Hugging Face Inference Providers (server-side only).
GPU_PROVIDER=huggingface-inference
HF_TOKEN=replace-in-secret-manager-with-inference-providers-permission
HF_MODEL=owner/model-with-an-enabled-inference-provider
GPU_PROVIDER_PRIVACY_ACKNOWLEDGED=false

# Local x402 agent API settings. Render enables x402 in render.yaml; only enable
# it in deployments after verifying the token metadata and facilitator transfer path.
X402_ENABLED=false
X402_NETWORK=eip155:42161
X402_ASSET_ADDRESS=0x004B506865409877C9fA29bfb1ebA929984B9bbC
X402_ASSET_DECIMALS=6
X402_ASSET_NAME=
X402_ASSET_VERSION=
X402_ASSET_TRANSFER_METHOD=
X402_RECIPIENT=
CDP_API_KEY_ID=replace-in-deployment-secret-manager
CDP_API_KEY_SECRET=replace-in-deployment-secret-manager
